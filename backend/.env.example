# App
APP_NAME=AI Avatar Platform
DEBUG=false
API_PREFIX=/api/v1

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./ai_coach.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_coach
# Cloud MI/Entra mode (local default remains password/DATABASE_URL):
# DATABASE_AUTH_MODE=azure_ad
# DATABASE_HOST=<server>.postgres.database.azure.com
# DATABASE_NAME=ai_coach
# DATABASE_USER=<backend-managed-identity-name>
# DATABASE_AUTO_CREATE_TABLES=false

# JWT Auth
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Feature Toggles
FEATURE_AVATAR_ENABLED=false
FEATURE_VOICE_ENABLED=false
FEATURE_REALTIME_VOICE_ENABLED=false
FEATURE_CONFERENCE_ENABLED=false

# Voice Mode: text_only | stt_tts | realtime | voice_live
DEFAULT_VOICE_MODE=text_only

# Region: global | china | eu
REGION=global

# AI Service Providers (default to mock for local dev)
DEFAULT_LLM_PROVIDER=mock
DEFAULT_STT_PROVIDER=mock
DEFAULT_TTS_PROVIDER=mock
DEFAULT_AVATAR_PROVIDER=mock

# Azure AI Foundry (master config — shared endpoint/key for all AI services)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEFAULT_PROJECT=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Azure Speech (STT/TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure Avatar
AZURE_AVATAR_ENDPOINT=
AZURE_AVATAR_KEY=

# Azure Content Understanding
AZURE_CONTENT_ENDPOINT=
AZURE_CONTENT_KEY=
# Override if Azure retires a CU API version; default is the stable 2025-11-01 API.
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01
# Cloud voice scoring can transcode browser WebM/Opus recordings to WAV PCM before CU.
# Local default is disabled so ffmpeg is not required for normal local development.
VOICE_SCORING_TRANSCODE_ENABLED=false
VOICE_SCORING_TRANSCODE_TIMEOUT_SECONDS=120

# Encryption (for API key storage — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# IMPORTANT: Must persist across server restarts or saved configs become unreadable
ENCRYPTION_KEY=
# Local default stores Admin UI service keys encrypted in DB. Cloud can use Key Vault.
SECRET_STORE=database
# AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net/

# Other AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Training Material Management
STORAGE_BACKEND=local
MATERIAL_STORAGE_PATH=./storage/materials
MATERIAL_MAX_SIZE_MB=4
MATERIAL_RETENTION_DAYS=365
# For Azure Container Apps, set STORAGE_BACKEND=azure_blob and prefer managed identity:
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_STORAGE_CONTAINER_NAME=materials
# AZURE_CLIENT_ID=<user-assigned-managed-identity-client-id>
# Optional connection-string fallback:
# AZURE_STORAGE_CONNECTION_STRING=
# Optional blob prefix within the container:
# AZURE_STORAGE_BLOB_PREFIX=
